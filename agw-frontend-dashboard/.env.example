# ============================================================
#  .env.example — agw-frontend-dashboard · CAPA 5 (UI)
#  Copiar a .env y rellenar. NUNCA versionar el .env real.
#  Recordatorio: NEXT_PUBLIC_* es visible en el navegador.
# ============================================================

# ── Cloud API ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://agw-cloud-api.vercel.app
API_URL=https://agw-cloud-api.vercel.app

# ── NextAuth v5 ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3652
# Generar: openssl rand -hex 32
NEXTAUTH_SECRET=

# ── Identificadores por defecto (MCD §10) ─────────────────
NEXT_PUBLIC_DEFAULT_GATEWAY_ID=FOG_RPI_HIERBABUENA_01
NEXT_PUBLIC_DEFAULT_NODE_ID=IoT-node-26.001

# ── Comportamiento de la UI ───────────────────────────────
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_FEATURE_PH=false
NEXT_PUBLIC_FEATURE_PUBLIC_PORTAL=false
