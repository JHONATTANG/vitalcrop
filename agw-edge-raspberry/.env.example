# ============================================================
#  .env — agw-edge-raspberry  ·  CAPA 3: Gateway físico (Fog)
#  VitalCrop AGW · PRODUCCIÓN DIRECTA
# ============================================================
#  Ubicación en la Raspberry Pi:  /opt/agw-edge/.env
#  Permisos recomendados:         chmod 600 /opt/agw-edge/.env
#                                 chown root:root /opt/agw-edge/.env
#
#  ⚠️ IMPORTANTE — La Raspberry NO se conecta a la base de datos.
#     No tiene ni debe tener DATABASE_URL. Habla únicamente con la
#     Cloud API por HTTPS usando AGW_CLOUD_API_KEY. Así, si el
#     gateway físico se ve comprometido, la base de datos no queda
#     expuesta. Es una decisión de arquitectura, no un olvido.
# ============================================================

# ────────────────────────────────────────────────────────────
#  IDENTIDAD DEL GATEWAY
# ────────────────────────────────────────────────────────────
#  Debe coincidir con gateways.gateway_id en la base de datos
#  y con el campo node_id que se envía a POST /api/telemetria.
AGW_GATEWAY_ID=FOG_RPI_HIERBABUENA_01
AGW_GATEWAY_LOCATION=Cultivo Indoor Hierbabuena
AGW_FIRMWARE_VERSION=1.0.0

# ────────────────────────────────────────────────────────────
#  NUBE — Cloud API
# ────────────────────────────────────────────────────────────
#  ✅ Leído hoy por config_loader.py (override de cloud.api_key)
AGW_CLOUD_API_KEY=

#  ⚠️ NO HAY API DESPLEGADA todavía.
#  Durante la Fase 3, la Raspberry apunta a la API corriendo en el
#  PC de desarrollo, por la LAN. Reemplaza <IP_DEL_PC> por la IP
#  real del equipo en la misma red (ipconfig / ip -br addr).
#  La API debe levantarse con --host 0.0.0.0 para ser alcanzable.
AGW_CLOUD_BASE_URL=http://<IP_DEL_PC>:8000

#  Si está en false, el edge NO intenta subir a la nube: acumula
#  todo en el buffer SQLite local. Útil para probar el eslabón
#  MQTT de forma aislada antes de tener API alcanzable.
AGW_CLOUD_ENABLED=false

AGW_CLOUD_TELEMETRY_ENDPOINT=/api/telemetria
AGW_CLOUD_HEALTH_ENDPOINT=/api/health
AGW_CLOUD_PUSH_TIMEOUT_S=10
AGW_CLOUD_RETRY_MAX=3
AGW_CLOUD_BATCH_SIZE=50
AGW_CLOUD_SYNC_INTERVAL_S=30

# ────────────────────────────────────────────────────────────
#  BROKER MQTT LOCAL (Mosquitto en esta misma Raspberry)
# ────────────────────────────────────────────────────────────
#  Puerto 1883 — es el que usa el firmware del ESP32 (MCD §4.1).
#  El config.yaml actual dice 1884: está MAL, se corrige en Fase 2.
AGW_MQTT_HOST=127.0.0.1
AGW_MQTT_PORT=1883
AGW_MQTT_KEEPALIVE=60
AGW_MQTT_CLIENT_ID=agw-edge-controller-01

#  Auth MQTT — DESACTIVADA en Fases 2-3 (allow_anonymous true).
#  Se activa en Fase 6. Al hacerlo, descomentar y crear el usuario:
#    sudo mosquitto_passwd -c /etc/mosquitto/passwd edge_controller
# AGW_MQTT_USERNAME=edge_controller
# AGW_MQTT_PASSWORD=

# ────────────────────────────────────────────────────────────
#  TOPICS MQTT — contrato canónico del firmware (MCD §4.1)
# ────────────────────────────────────────────────────────────
AGW_TOPIC_TELEMETRIA=cultivo/indoor/hierbabuena/telemetria
AGW_TOPIC_ALERTA=cultivo/indoor/hierbabuena/alerta
AGW_TOPIC_STATUS=cultivo/indoor/hierbabuena/status
AGW_TOPIC_CMD=cultivo/indoor/hierbabuena/cmd

# ────────────────────────────────────────────────────────────
#  RED PRIVADA DEL CULTIVO (wlan0 en modo Access Point)
# ────────────────────────────────────────────────────────────
#  Debe coincidir con include/config.h del firmware ESP32.
AGW_AP_SSID=CULTIVO_INDOOR_WIFI
AGW_AP_PASSPHRASE=
AGW_AP_INTERFACE=wlan0
AGW_AP_IP=10.42.0.1
AGW_AP_DHCP_START=10.42.0.10
AGW_AP_DHCP_END=10.42.0.50
AGW_AP_CHANNEL=6
AGW_AP_COUNTRY=CO

# ────────────────────────────────────────────────────────────
#  BUFFER LOCAL SQLite (resiliencia sin internet)
# ────────────────────────────────────────────────────────────
AGW_DB_PATH=/var/lib/agw/buffer.db
AGW_MAX_BUFFERED_RECORDS=50000
AGW_BUFFER_RETENTION_DAYS=30

# ────────────────────────────────────────────────────────────
#  SERVIDOR DE SALUD / MÉTRICAS
# ────────────────────────────────────────────────────────────
AGW_HEALTH_HOST=0.0.0.0
AGW_HEALTH_PORT=8080

# ────────────────────────────────────────────────────────────
#  MOTOR DE REGLAS LOCAL
# ────────────────────────────────────────────────────────────
AGW_RULES_ENABLED=true
AGW_RULES_FILE=/opt/agw-edge/rules/rules.yaml

# ────────────────────────────────────────────────────────────
#  MÉTRICAS DE TELECOMUNICACIONES (MCD §9)
# ────────────────────────────────────────────────────────────
#  Registra t_rx, latencias y contadores de pérdida. Es el
#  instrumental del que sale la analítica del proyecto de grado.
AGW_TELEMETRY_METRICS_ENABLED=true
AGW_METRICS_LOG_PATH=/var/log/agw/metrics.jsonl

# ────────────────────────────────────────────────────────────
#  LOGGING
# ────────────────────────────────────────────────────────────
AGW_LOG_LEVEL=INFO
AGW_LOG_FORMAT=json

# ════════════════════════════════════════════════════════════
#  ESTADO DE CABLEADO
#  Hoy config_loader.py solo lee AGW_CLOUD_API_KEY y AGW_GATEWAY_ID.
#  El resto vive en config.yaml. La Fase 2 conecta todas estas
#  variables al loader para que .env sea la única fuente de
#  configuración de la Raspberry.
# ════════════════════════════════════════════════════════════
