# Mosquitto password file — managed with: mosquitto_passwd -c /etc/mosquitto/passwd <username>
#
# Generate passwords with:
#   sudo mosquitto_passwd /etc/mosquitto/passwd esp32_node
#   sudo mosquitto_passwd /etc/mosquitto/passwd edge_controller
